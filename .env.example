# این فایل را کپی کنید به اسم .env و مقادیر را پر کنید
# cp .env.example .env

# توکنی که BotFather داد
BOT_TOKEN=

# کلید API سایت navasan.tech
NAVASAN_API_KEY=

CHANNEL_ID=@dollar_tala_live
BOT_USERNAME=@dollar_tala_live_bot

# هر چند دقیقه قیمت چک شود (به سقف درخواست پلن نوسان دقت کنید)
CHECK_INTERVAL_MINUTES=15
# درصد تغییر برای پست فوری
ALERT_PERCENT=1.0
# حداقل فاصله بین دو پست فوری (دقیقه)
ALERT_COOLDOWN_MINUTES=30
# ساعات سکوت شب (فقط پست فوری)
QUIET_START_HOUR=0
QUIET_END_HOUR=8
TIMEZONE=Asia/Tehran
