[Unit]
Description=Dollar Tala Live Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/dollar-tala-live-bot
ExecStart=/root/dollar-tala-live-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
